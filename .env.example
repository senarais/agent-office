# Backend only. Never prefix credentials with VITE_.
PORT=3001
GAME_PORT=5173
DATA_DIR=.local-data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENCODE_URL=
# Optional HTTP basic-auth password for an OpenCode server.
OPENCODE_SERVER_PASSWORD=
GENERIC_BASE_URL=
GENERIC_API_KEY=
GENERIC_MODEL=
# Command Code CLI (optional import). Authenticate the CLI with `cmd login` first.
COMMAND_CODE_BIN=
COMMAND_CODE_MODEL=
# Telegram report delivery and social approvals (optional). Backend only.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. Only these chats may approve or request revisions.
TELEGRAM_CHAT_ID=
# Social posting and analytics use local Playwright browser automation. Log in once in-game.
# false is more reliable for X/Instagram UI automation; true runs without a visible window.
SOCIAL_BROWSER_HEADLESS=false
# Optional Chrome/Chromium executable path. Empty uses Playwright's bundled browser.
SOCIAL_BROWSER_EXECUTABLE=
SOCIAL_BROWSER_TIMEOUT_MS=60000
# Optional direct image generation for post media. Uses OPENAI_API_KEY above.
OPENAI_IMAGE_MODEL=
# Optional Supabase durable replication. Service-role key remains server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional external 32-byte vault key, base64. Otherwise generated in DATA_DIR.
VAULT_KEY=
# Demo provider is available only when explicitly enabled (tests/offline animation).
ENABLE_DEMO_PROVIDER=false
# Recurring tasks, weapon balance, blood and machine settings are configured IN GAME.
# No cron service or extra scheduler environment variables are required.
# Keep this local server/computer running for automatic work to execute.
