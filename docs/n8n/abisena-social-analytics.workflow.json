    {
      "id": "bc3199d6-a2ed-4e88-936b-b4403c9172de",
      "name": "Analytics: Combine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        40
      ],
      "parameters": {
        "jsCode": "const accounts = [], posts = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  if (Array.isArray(d.accounts)) accounts.push(...d.accounts);\n  if (Array.isArray(d.posts)) posts.push(...d.posts);\n}\nreturn [{ json: { accounts, posts } }];"
      }
    },
