    {
      "id": "eec442bf-572c-472b-b081-3bd8dc792737",
      "name": "X: Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -220
      ],
      "parameters": {
        "jsCode": "const me = $('X: Me').first().json.data;\nconst tweets = $input.all().flatMap(item => item.json.data || []);\nconst posts = tweets.map(tweet => {\n  const m = tweet.public_metrics || {};\n  return {\n    platform: 'x', externalId: tweet.id, caption: tweet.text || '', mediaUrls: [],\n    permalink: 'https://x.com/' + me.username + '/status/' + tweet.id,\n    postedAt: tweet.created_at || new Date().toISOString(),\n    likes: m.like_count || 0, comments: m.reply_count || 0,\n    shares: (m.retweet_count || 0) + (m.quote_count || 0), saves: 0,\n    impressions: m.impression_count || 0, reach: 0, clicks: 0,\n  };\n});\nreturn [{ json: { accounts: [{ platform: 'x', handle: me.username, displayName: me.name || me.username, connected: true, followers: me.public_metrics?.followers_count || 0, following: me.public_metrics?.following_count || 0, posts: me.public_metrics?.tweet_count || 0 }], posts } }];"
      }
    },
