      "parameters": {
        "method": "GET",
        "url": "=https://api.x.com/2/users/{{ $('X: Me').first().json.data.id }}/tweets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twitterOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "max_results",
              "value": "20"
            },
