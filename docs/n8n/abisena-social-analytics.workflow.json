    {
      "id": "252761fa-1c50-43fe-8b4d-2ece675db330",
      "name": "IG: Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        160
      ],
      "parameters": {
        "jsCode": "const media = $input.first().json.data || [];\nconst account = $('IG: Account').first().json;\nconst posts = media.map(item => ({\n  platform: 'instagram', externalId: item.id, caption: item.caption || '',\n  mediaUrls: [item.media_url, item.thumbnail_url].filter(Boolean),\n  permalink: item.permalink, postedAt: item.timestamp || new Date().toISOString(),\n  likes: item.like_count || 0, comments: item.comments_count || 0, shares: 0, saves: 0,\n  impressions: 0, reach: 0, clicks: 0,\n}));\nreturn [{ json: { accounts: [{ platform: 'instagram', handle: account.username || 'instagram', displayName: account.username || 'Instagram', connected: true, followers: account.followers_count || 0, posts: account.media_count || 0 }], posts } }];"
      }
    },
    {
      "id": "dad20973-29d0-42b0-939e-f0f4670db345",
      "name": "IG: Empty",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
