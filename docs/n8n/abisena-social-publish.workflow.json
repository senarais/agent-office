    {
      "id": "7933c460-ffeb-4d20-a40e-8dc16b626437",
      "name": "Publish: Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst mediaUrls = Array.isArray(body.mediaUrls) ? body.mediaUrls.filter(u => typeof u === 'string' && u) : [];\nlet caption = typeof body.caption === 'string' ? body.caption.trim() : '';\nif (body.platform === 'x') {\n  caption = caption.replace(/\\s+/g, ' ').trim();\n  const media = mediaUrls[0];\n  if (media && caption.length + media.length + 1 <= 280) caption = caption + '\\n' + media;\n  if (caption.length > 280) caption = caption.slice(0, 277) + '...';\n}\nreturn [{ json: { ...body, mediaUrls, caption } }];"
      }
    },
