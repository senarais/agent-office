        "url": "=https://graph.facebook.com/v21.0/{{ $json.pageId }}/feed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.caption, ...($json.link ? { link: $json.link } : {}) }) }}",
        "options": {}
      },
