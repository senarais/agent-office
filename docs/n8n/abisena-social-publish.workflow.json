        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('IG: Prepare').first().json.igUser }}/media_publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creation_id: $json.id }) }}",
        "options": {}
      },
      "credentials": {
