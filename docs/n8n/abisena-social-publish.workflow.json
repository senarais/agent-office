    {
      "id": "05d36e54-210c-47e5-95ab-108950be1987",
      "name": "X: Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.x.com/2/tweets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twitterOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.caption }) }}",
        "options": {}
      }
    },
    {
      "id": "64501c11-1acc-4209-83a2-0efdb759efbc",
      "name": "X: Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -220
      ],
      "parameters": {
        "jsCode": "const data = $json.data || $json;\nconst id = data && data.id ? String(data.id) : '';\nif (!id) throw new Error('X API returned no tweet id: ' + JSON.stringify($json).slice(0, 500));\nreturn [{ json: { externalId: id, url: 'https://x.com/i/web/status/' + id, postedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "0d7d22cb-cea2-43ea-8e19-90a7421db8a2",
      "name": "IG: Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -40
      ],
      "parameters": {
        "jsCode": "const body = $json;\nconst igUser = String($('Config').first().json.instagramUserId || '').trim();\nif (!igUser) throw new Error('Instagram user ID is not set in the Config node.');\nif (!body.mediaUrls || !body.mediaUrls[0]) throw new Error('Instagram requires an image URL. Generate media first.');\nreturn [{ json: { igUser, imageUrl: body.mediaUrls[0], caption: body.caption || '' } }];"
      }
    },
    {
      "id": "3f2cb835-05a4-4c25-8f72-bff3153492b1",
      "name": "IG: Create Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        -40
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.igUser }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: $json.imageUrl, caption: $json.caption }) }}",
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "C4fEyaIphDWA8fuC",
          "name": "Meta Access Token"
        }
      }
    },
    {
