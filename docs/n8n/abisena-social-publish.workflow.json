    {
      "id": "a58072d5-6415-4913-8c23-462defa692ee",
      "name": "IG: Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        -40
      ],
      "parameters": {
        "jsCode": "const id = $json.id ? String($json.id) : '';\nif (!id) throw new Error('Instagram returned no media id.');\nreturn [{ json: { externalId: id, postedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "02c69e0e-84f9-4bc8-b758-53c656312a8e",
      "name": "FB: Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        140
      ],
      "parameters": {
        "jsCode": "const body = $json;\nconst pageId = String($('Config').first().json.facebookPageId || '').trim();\nif (!pageId) throw new Error('Facebook Page ID is not set in the Config node.');\nreturn [{ json: { pageId, caption: body.caption || '', link: (body.mediaUrls || [])[0] || '' } }];"
      }
    },
    {
      "id": "59d0ad1b-311d-4c0c-8bd5-a257f3f739a1",
      "name": "FB: Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
